# Copy to `.env` and fill in your own keys. NEVER commit the real .env (it is gitignored).
# Only the providers for the models you actually run are required.

# --- Azure OpenAI (used for GPT-4.1 / GPT-4o / GPT-3.5-turbo deployments) ---
AZURE_OPENAI_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- OpenAI (optional) ---
OPENAI_API_KEY=your_openai_key

# --- Google Gemini (used for Gemini-2.5-Flash / -Pro) ---
GEMINI_API_KEY=your_gemini_key

# --- Anthropic (used for Claude models) ---
ANTHROPIC_API_KEY=your_anthropic_key

# --- Azure AI Foundry v1 endpoint (grok / GPT-5.x deployments; reuses AZURE_OPENAI_KEY) ---
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
